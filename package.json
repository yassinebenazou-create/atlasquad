  "dependencies": {
    "@lucide/astro": "^1.48.0",
    "astro": "^7.3.5",
    "simple-icons": "^16.33.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.0"
  }
