---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourBookingCard from '../../components/TourBookingCard.astro';
import TourDetailHero from '../../components/TourDetailHero.astro';
import TourGallery from '../../components/TourGallery.astro';
import TourIncludedExcluded from '../../components/TourIncludedExcluded.astro';
import TourReviewForm from '../../components/TourReviewForm.astro';
import { tours, type Tour } from '../../data/tours';

export function getStaticPaths() {
  return tours.map((tour) => ({ params: { slug: tour.slug }, props: { tour } }));
}

type Props = { tour: Tour };
const { tour } = Astro.props;
---

<BaseLayout title={`${tour.title} | Atlas Quad Palmeraie`} description={tour.description} pathname={`/tours/${tour.slug}/`}>
  <TourDetailHero tour={tour} />

  <section class="tour-detail-page">
    <div class="tour-detail-container">
      <div class="tour-detail-layout">
        <div class="gallery-area">
          <TourGallery tour={tour} />
        </div>

        <div class="booking-column">
          <TourBookingCard tour={tour} />
        </div>

        <section class="overview" aria-labelledby="overview-heading">
          <h2 id="overview-heading" data-reveal="up">Overview</h2>
          <p data-reveal="up" style="--delay: 80ms">{tour.overview}</p>
        </section>

        <div class="included-area" data-reveal="up">
          <TourIncludedExcluded tour={tour} />
        </div>

        <div class="reviews-area" data-reveal="up">
          <TourReviewForm tour={tour} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tour-detail-page {
    width: 100%;
    padding: 18px 0 52px;
    background: #fff;
  }

  .tour-detail-container {
    width: min(calc(100% - 40px), 1700px);
    margin-inline: auto;
  }

  .tour-detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    grid-template-areas:
      "gallery booking"
      "overview booking"
      "included booking"
      "reviews booking";
    gap: 28px;
    align-items: start;
  }

  .gallery-area {
    min-width: 0;
    grid-area: gallery;
  }

  .booking-column {
    grid-area: booking;
    position: sticky;
    top: 84px;
  }

  .overview {
    grid-area: overview;
    padding-bottom: 2px;
  }

  .included-area {
    grid-area: included;
  }

  .reviews-area {
    grid-area: reviews;
  }

  .overview h2 {
    margin: 0 0 10px;
    color: #071b46;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 3vw, 42px);
    line-height: 1.05;
  }

  .overview p {
    max-width: 1180px;
    margin: 0;
    color: #59677a;
    font-size: 16px;
    line-height: 1.65;
  }

  @media (max-width: 1100px) {
    .tour-detail-layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        "gallery"
        "booking"
        "overview"
        "included"
        "reviews";
    }

    .booking-column {
      position: static;
    }

    .booking-column > :global(*) {
      max-width: 620px;
    }
  }

  @media (max-width: 760px) {
    .tour-detail-page {
      padding-top: 12px;
    }

    .tour-detail-container {
      width: calc(100% - 24px);
    }

    .tour-detail-layout {
      gap: 24px;
    }

    .booking-column > :global(*) {
      max-width: none;
    }

    .overview h2 {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 30px;
      font-weight: 900;
    }

    .overview p {
      font-size: 15px;
    }
  }
</style>
