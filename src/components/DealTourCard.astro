---
import { ArrowRight, Clock3, Flame, Users } from '@lucide/astro';
import type { FeaturedDeal } from '../data/tours';

type Props = { deal: FeaturedDeal };
const { deal } = Astro.props;
---

<article class="deal-card">
  <a class="deal-image" href={deal.href} aria-label={`Explore ${deal.title}`}>
    <img src={deal.image} alt={deal.imageAlt} loading="lazy" onerror="this.remove()" />
    {deal.badge && <span class="deal-badge"><Flame size={15} fill="currentColor" strokeWidth={2.2} />{deal.badge}</span>}
  </a>
  <div class="deal-content">
    <h3><a href={deal.href}>{deal.title}</a></h3>
    <div class="deal-meta">
      <span><Clock3 size={19} strokeWidth={2.4} /><span>{deal.duration}</span></span>
      <span><Users size={20} strokeWidth={2.4} /><span>{deal.audience}</span></span>
    </div>
    <div class="deal-footer">
      <div class="deal-price"><span>From</span><strong>{deal.price}</strong></div>
      <a class="explore-link" href={deal.href} aria-label={`Explore ${deal.title}`}>Explore <ArrowRight size={21} strokeWidth={2.2} /></a>
    </div>
  </div>
</article>

<style>
  .deal-card {
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(7, 27, 70, 0.07);
    transition: transform 280ms var(--motion-ease), box-shadow 280ms var(--motion-ease);
  }

  .deal-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 34px rgba(7, 27, 70, 0.12);
  }

  .deal-image {
    position: relative;
    display: block;
    height: 180px;
    overflow: hidden;
    background: linear-gradient(135deg, #f4d7c3, #f8eee6 55%, #e1e8e6);
  }

  .deal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 450ms var(--motion-ease);
  }

  .deal-card:hover .deal-image img {
    transform: scale(1.04);
  }

  .deal-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 999px;
    background: #ff5b0a;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .deal-content {
    padding: 17px 24px 18px;
  }

  h3 {
    min-height: 52px;
    margin: 0 0 14px;
    color: #071b46;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.18rem, 1.65vw, 1.36rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .deal-meta {
    min-height: 32px;
    display: grid;
    grid-template-columns: minmax(92px, 0.72fr) minmax(0, 1.28fr);
    align-items: center;
    gap: 12px;
    color: #6f6f6f;
    font-size: 0.84rem;
  }

  .deal-meta > span {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .deal-meta svg {
    flex: 0 0 auto;
    color: #ff5b0a;
  }

  .deal-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 15px;
    padding-top: 13px;
    border-top: 1px solid #eaeaea;
  }

  .deal-price span,
  .deal-price strong {
    display: block;
  }

  .deal-price span {
    margin-bottom: 1px;
    color: #777;
    font-size: 0.78rem;
  }

  .deal-price strong {
    color: #ff5b0a;
    font-size: 1.52rem;
    line-height: 1;
  }

  .explore-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    color: #071b46;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .explore-link svg {
    color: #ff5b0a;
    transition: transform 300ms ease;
  }

  .explore-link:hover svg,
  .explore-link:focus-visible svg {
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .deal-image { height: 200px; }
    .deal-content { padding-inline: 20px; }
    h3 { min-height: 0; font-size: 1.28rem; }
  }
</style>
