---
import { ExternalLink } from '@lucide/astro';
import { googleBusiness } from '../data/contact';
---

<section class="google-reviews" aria-labelledby="reviews-heading">
  <div class="reviews-inner">
    <div class="reviews-header">
      <div>
        <p class="section-label" data-reveal="left"><span aria-hidden="true"></span> Google reviews</p>
        <h2 id="reviews-heading" data-reveal="up" style="--delay: 70ms">What our guests say</h2>
      </div>
      <div class="reviews-actions" data-reveal="up" style="--delay: 120ms">
        <a href={googleBusiness.mapsUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-clearance>
          View all reviews on Google <ExternalLink size={16} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="reviews-widget" aria-label="Google reviews for Atlas Quad Palmeraie" data-reveal="up" style="--delay: 180ms">
      <div class="sk-ww-google-reviews" data-embed-id="25717430"></div>
      <noscript><p>Enable JavaScript to view Google reviews.</p></noscript>
    </div>
  </div>
</section>

<script is:inline src="https://widgets.sociablekit.com/google-reviews/widget.js" defer></script>

<style>
  .google-reviews {
    width: 100%;
    padding: 30px 0 34px;
    background: #faf8f5;
  }

  .reviews-inner {
    width: min(calc(100% - 32px), 1800px);
    margin-inline: auto;
  }

  .reviews-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 18px;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 7px;
    color: #ff641f;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .section-label span {
    width: 30px;
    height: 2px;
    background: currentColor;
  }

  h2 {
    margin: 0;
    color: #082b4f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(30px, 2.4vw, 42px);
    line-height: 1;
  }

  .reviews-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .reviews-actions > a {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 8px 18px;
    border: 1px solid #ff641f;
    border-radius: 999px;
    color: #e95512;
    background: #fff;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
    transition: color 180ms ease, background 180ms ease;
  }

  .reviews-actions > a:hover,
  .reviews-actions > a:focus-visible {
    color: #fff;
    background: #ff641f;
  }

  .reviews-widget {
    width: 100%;
    min-height: 180px;
  }

  .sk-ww-google-reviews {
    width: 100%;
    min-height: 180px;
  }

  noscript p {
    margin: 0;
    padding: 24px;
    border: 1px solid #e8e8e8;
    border-radius: 10px;
    background: #fff;
    color: #6b7280;
    text-align: center;
  }

  @media (max-width: 980px) {
    .reviews-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .reviews-actions {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .google-reviews {
      padding-block: 28px;
    }

    .reviews-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }

    .reviews-actions > a {
      width: 100%;
      white-space: normal;
      text-align: center;
    }

  }
</style>
