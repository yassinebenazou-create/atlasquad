---
import { contact, site } from '../data/tours';
import { Phone } from '@lucide/astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/tours/', label: 'Tours' },
  { href: '/#services', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
  { href: '/#about', label: 'About Us' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Atlas Quad Palmeraie home">
      <span class="logo-frame"><img src={site.logo} alt="Atlas Quad Palmeraie logo" decoding="async" /></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map((item) => <a class:list={{ active: current === item.href || (item.href === '/tours/' && current.startsWith('/tours')) }} href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="phone-badge" href={contact.phoneHref} aria-label={`Call ${contact.phone}`}><span class="icon-pill" aria-hidden="true"><Phone size={21} strokeWidth={2.7} /></span><strong>{contact.phone}</strong></a>
      <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile navigation">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    <a class="button" href={contact.whatsappHref} target="_blank" rel="noreferrer">Contact on WhatsApp</a>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    if (menu instanceof HTMLElement) menu.hidden = isOpen;
    document.body.classList.toggle('menu-open', !isOpen);
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; height: 88px; background: #fff; box-shadow: 0 1px 0 rgba(7,27,63,.06); }
  .nav-shell { width: min(calc(100% - 56px),1680px); height: 100%; margin-inline: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; }
  .brand { position: relative; z-index: 2; justify-self: start; }
  .logo-frame { display: block; width: 110px; height: 98px; margin-top: 10px; }
  .logo-frame img { width: 100%; height: 100%; object-fit: contain; }
  .desktop-nav { display: flex; align-items: center; justify-content: center; gap: clamp(2rem,3vw,3.2rem); font-size: .95rem; font-weight: 750; }
  .desktop-nav a { position: relative; padding: 2rem 0; transition: color 200ms ease; }
  .desktop-nav a::after { content: ""; position: absolute; left: 0; right: 0; bottom: .95rem; height: 2px; border-radius: 99px; background: var(--orange); transform: scaleX(0); transform-origin: left center; transition: transform 220ms var(--motion-ease); }
  .desktop-nav a:hover, .desktop-nav a:focus-visible, .desktop-nav a.active { color: var(--orange); }
  .desktop-nav a.active::after, .desktop-nav a:hover::after { transform: scaleX(1); }
  .header-actions { justify-self: end; display: flex; align-items: center; gap: 1rem; }
  .phone-badge { display: inline-flex; align-items: center; gap: .8rem; font-size: 1rem; }
  .phone-badge .icon-pill { width: 3rem; height: 3rem; box-shadow: none; }
  .menu-toggle { display: none; width: 3rem; height: 3rem; border: 0; background: transparent; padding: .5rem; }
  .menu-toggle span { display: block; height: 4px; margin: 5px 0; border-radius: 99px; background: var(--ink); }
  .mobile-menu { position: fixed; inset: 88px 0 auto; z-index: 1; padding: 1.25rem; background: #fff; box-shadow: var(--shadow); }
  .mobile-menu nav { display: grid; gap: .35rem; margin-bottom: 1rem; }
  .mobile-menu a:not(.button) { padding: .9rem; border-radius: var(--radius); font-weight: 800; background: var(--cream); }
  @media (max-width: 900px) {
    .site-header { height: 86px; }
    .nav-shell { width: calc(100% - 2.2rem); display: flex; justify-content: space-between; }
    .desktop-nav, .phone-badge strong { display: none; }
    .logo-frame { width: 92px; height: 78px; margin-top: 7px; }
    .phone-badge .icon-pill { width: 2.5rem; height: 2.5rem; }
    .menu-toggle { display: block; }
    .mobile-menu { inset: 86px 0 auto; }
  }
</style>
