---
import { ChevronDown } from '@lucide/astro';
import type { Tour } from '../data/tours';

type Props = { tour: Tour };
const { tour } = Astro.props;
---

<section class="tour-faq" aria-labelledby="tour-faq-heading">
  <p class="eyebrow" data-reveal="left">Helpful details</p>
  <h2 id="tour-faq-heading" data-reveal="up" style="--delay: 70ms">Frequently asked questions</h2>
  <div class="faq-list">
    {tour.faqs.map((item, index) => (
      <details data-reveal="up" style={`--delay: ${Math.min(index * 60, 180)}ms`}>
        <summary>
          <span>{item.question}</span>
          <ChevronDown size={20} strokeWidth={2.2} aria-hidden="true" />
        </summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .tour-faq {
    padding-top: 12px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #ff5b0a;
  }

  h2 {
    margin: 0 0 18px;
    color: #071b46;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(32px, 3vw, 42px);
    line-height: 1.05;
  }

  .faq-list {
    border-top: 1px solid #e5e7eb;
  }

  details {
    border-bottom: 1px solid #e5e7eb;
  }

  summary {
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 2px;
    color: #071b46;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: 0 0 auto;
    color: #ff5b0a;
    transition: transform 180ms ease;
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  details p {
    max-width: 920px;
    margin: -2px 0 18px;
    color: #59677a;
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    h2 {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 29px;
      font-weight: 900;
    }

    summary {
      font-size: 15px;
    }
  }
</style>
