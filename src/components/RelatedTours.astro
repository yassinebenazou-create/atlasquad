---
import { ArrowRight, Clock3, MapPin } from '@lucide/astro';
import type { Tour } from '../data/tours';

type Props = { tours: Tour[] };
const { tours } = Astro.props;
---

{tours.length > 0 && (
  <section class="related-tours" aria-labelledby="related-tours-heading">
    <p class="eyebrow" data-reveal="left">Continue exploring</p>
    <h2 id="related-tours-heading" data-reveal="up" style="--delay: 70ms">Related Marrakech activities</h2>
    <div class="related-grid">
      {tours.map((tour, index) => (
        <article data-reveal="scale" style={`--delay: ${index * 70}ms`}>
          <a class="related-image" href={`/tours/${tour.slug}/`} aria-label={`View ${tour.title}`}>
            <img src={tour.cardImage} alt={tour.imageAlt} loading="lazy" decoding="async" />
          </a>
          <div class="related-copy">
            <h3><a href={`/tours/${tour.slug}/`}>{tour.title}</a></h3>
            <p><span><Clock3 size={16} aria-hidden="true" />{tour.duration}</span><span><MapPin size={16} aria-hidden="true" />{tour.location}</span></p>
            <a class="related-link" href={`/tours/${tour.slug}/`}>View activity <ArrowRight size={18} aria-hidden="true" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .related-tours {
    padding-top: 12px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #ff5b0a;
  }

  .related-tours > h2 {
    margin: 0 0 18px;
    color: #071b46;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(32px, 3vw, 42px);
    line-height: 1.05;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  article {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(7, 27, 70, .07);
    transition: transform 220ms var(--motion-ease), box-shadow 220ms ease;
  }

  article:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(7, 27, 70, .11);
  }

  .related-image {
    height: 150px;
    display: block;
    overflow: hidden;
    background: #eee9e2;
  }

  .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms var(--motion-ease);
  }

  article:hover .related-image img,
  .related-image:focus-visible img {
    transform: scale(1.02);
  }

  .related-copy {
    padding: 16px;
  }

  h3 {
    min-height: 2.65em;
    margin: 0;
    color: #071b46;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    line-height: 1.3;
  }

  .related-copy > p {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin: 13px 0;
    color: #657187;
    font-size: 12px;
  }

  .related-copy > p span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .related-copy > p :global(svg) {
    color: #ff5b0a;
  }

  .related-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #071b46;
    font-size: 13px;
    font-weight: 800;
  }

  .related-link :global(svg) {
    color: #ff5b0a;
  }

  @media (max-width: 760px) {
    .related-tours > h2 {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 29px;
      font-weight: 900;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .related-image {
      height: 190px;
    }

    h3 {
      min-height: 0;
    }
  }
</style>
