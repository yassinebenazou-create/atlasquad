---
import { ArrowDownUp, SlidersHorizontal } from '@lucide/astro';

type Props = { count: number };
const { count } = Astro.props;
---

<div class="tours-toolbar">
  <div class="results" id="result-count"><strong>{count}</strong> <span>Tours</span></div>
  <button class="filter-toggle" type="button" aria-controls="filters" aria-expanded="false">
    <SlidersHorizontal size={15} strokeWidth={2} aria-hidden="true" /> Filters
  </button>
  <label class="sort-control">
    <span>Sort by</span>
    <ArrowDownUp size={13} strokeWidth={2} aria-hidden="true" />
    <select id="sort" aria-label="Sort tours">
      <option value="title">Title</option>
      <option value="price-asc">Price: low to high</option>
      <option value="price-desc">Price: high to low</option>
    </select>
  </label>
</div>

<style>
  .tours-toolbar {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 4px;
    margin-bottom: 18px;
  }

  .results {
    color: #071b46;
    font-size: 17px;
    font-weight: 700;
  }

  .results strong {
    color: #ff5b0a;
    font-size: 18px;
  }

  .sort-control {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #7b8290;
    font-size: 13px;
  }

  .sort-control svg {
    width: 16px;
    height: 16px;
    color: #071b46;
  }

  .sort-control select {
    min-width: 120px;
    width: 132px;
    height: 40px;
    padding: 0 28px 0 12px;
    border: 1px solid #dfe3e9;
    border-radius: 4px;
    color: #747d8b;
    background: #fff;
    font-size: 13px;
  }

  .filter-toggle {
    display: none;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 8px 13px;
    border: 1px solid #dfe3e9;
    border-radius: 5px;
    color: #071b46;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 899px) {
    .tours-toolbar {
      padding-inline: 0;
    }

    .filter-toggle {
      display: inline-flex;
      margin-left: auto;
    }

    .sort-control {
      font-size: 13px;
    }

    .sort-control select {
      width: 120px;
      height: 40px;
      font-size: 13px;
    }
  }

  @media (max-width: 639px) {
    .tours-toolbar {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 8px;
    }

    .filter-toggle {
      margin-left: auto;
    }

    .sort-control > span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .sort-control select {
      min-width: 90px;
      width: 90px;
    }
  }
</style>
