<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const statsSections = Array.from(document.querySelectorAll<HTMLElement>('[data-stats-section]'));

  if (!reducedMotion && 'IntersectionObserver' in window && (revealItems.length || statsSections.length)) {
    document.documentElement.classList.add('motion-ready');

    statsSections.forEach((section) => {
      section.querySelectorAll<HTMLElement>('[data-stat-value]').forEach((value) => {
        value.textContent = `0${value.dataset.suffix ?? ''}`;
      });
    });

    const animateStats = (section: HTMLElement) => {
      const values = Array.from(section.querySelectorAll<HTMLElement>('[data-stat-value]'));
      const start = performance.now();
      const duration = 1500;

      const animate = (time: number) => {
        const progress = Math.min((time - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);

        values.forEach((element) => {
          const target = Number(element.dataset.target ?? 0);
          const current = Math.round(target * eased);
          element.textContent = `${current.toLocaleString('en-US')}${element.dataset.suffix ?? ''}`;
        });

        if (progress < 1) requestAnimationFrame(animate);
      };

      requestAnimationFrame(animate);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const target = entry.target as HTMLElement;
        if (target.matches('[data-reveal]')) target.classList.add('is-visible');
        if (target.matches('[data-stats-section]')) animateStats(target);
        observer.unobserve(entry.target);
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -40px 0px',
    });

    [...new Set([...revealItems, ...statsSections])].forEach((item) => observer.observe(item));
  }
</script>
