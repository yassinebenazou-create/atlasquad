---
import type { Tour } from '../data/tours';

type Props = { tour: Tour };
const { tour } = Astro.props;
---

<div
  class:list={[
    'tour-gallery',
    {
      'stack-mobile': [
        'palm-grove-2-hours-quad-bike-tour',
        'quad-bike-camel-ride-marrakech-palmeraie',
        'hot-air-balloon-marrakech-sunrise-atlas-view',
        '20-minute-paragliding-transport-marrakech',
        'camel-ride-palm-grove-marrakech',
      ].includes(tour.slug),
    },
  ]}
  aria-label={`${tour.shortTitle} photo gallery`}
>
  {tour.gallery.map((image, index) => (
    <a
      class:list={['gallery-image', { main: index === 0 }]}
      href={image}
      target="_blank"
      rel="noopener"
      aria-label={`Open gallery image ${index + 1}`}
      data-reveal="up"
      style={`--delay: ${index * 70}ms`}
    >
      <img
        src={image}
        alt={tour.galleryAlts?.[index] ?? `${tour.imageAlt}, gallery view ${index + 1}`}
        loading={index === 0 ? 'eager' : 'lazy'}
      />
    </a>
  ))}
</div>

<style>
  .tour-gallery {
    height: clamp(470px, 38vw, 650px);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(220px, .72fr);
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .gallery-image {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 10px;
    background: #edf0f2;
  }

  .gallery-image.main {
    grid-row: 1 / -1;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 450ms var(--motion-ease), opacity 300ms ease;
  }

  .gallery-image:hover img,
  .gallery-image:focus-visible img {
    transform: scale(1.02);
    opacity: .96;
  }

  @media (max-width: 760px) {
    .tour-gallery {
      height: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: 300px 108px;
      gap: 8px;
    }

    .gallery-image.main {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .gallery-image:not(.main) {
      grid-row: 2;
    }

    .tour-gallery.stack-mobile {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .tour-gallery.stack-mobile .gallery-image,
    .tour-gallery.stack-mobile .gallery-image.main,
    .tour-gallery.stack-mobile .gallery-image:not(.main) {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 16 / 9;
    }

    .tour-gallery.stack-mobile .gallery-image.main {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 460px) {
    .tour-gallery {
      grid-template-rows: 245px 86px;
    }
  }
</style>
