---
import type { Tour } from '../data/tours';

type Props = { tour: Tour };
const { tour } = Astro.props;
---

<section class="tour-content" aria-label={`About ${tour.shortTitle}`}>
  {tour.contentSections.map((section, index) => (
    <article data-reveal="up" style={`--delay: ${index * 70}ms`}>
      <h2>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </article>
  ))}
</section>

<style>
  .tour-content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    padding-block: 8px 4px;
  }

  article {
    min-width: 0;
    padding-top: 22px;
    border-top: 2px solid #ff5b0a;
  }

  h2 {
    margin: 0 0 12px;
    color: #071b46;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(25px, 2vw, 31px);
    line-height: 1.12;
  }

  p {
    margin: 0;
    color: #59677a;
    font-size: 15px;
    line-height: 1.68;
  }

  p + p {
    margin-top: 10px;
  }

  @media (max-width: 760px) {
    .tour-content {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    h2 {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 24px;
      font-weight: 900;
    }
  }
</style>
