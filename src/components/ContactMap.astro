---
import { CarFront, ExternalLink, Map, MapPin, Star } from '@lucide/astro';
import { googleBusiness } from '../data/contact';
---

<article class="contact-map-card" aria-labelledby="map-heading" data-reveal="right" style="--delay: 100ms">
  <p class="section-label" data-reveal="left"><span aria-hidden="true"></span> Find us on the map</p>
  <h2 id="map-heading" data-reveal="up" style="--delay: 70ms">Our location in Marrakech</h2>
  <p class="map-description">We are based in the heart of the Palmeraie, just minutes from central Marrakech.<br />Easily accessible by car, taxi or hotel transfer.</p>

  <div class="map-frame">
    <iframe
      src={googleBusiness.embedUrl}
      title={`Map showing ${googleBusiness.name}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
    <a href={googleBusiness.mapsUrl} target="_blank" rel="noopener noreferrer">
      Open in Google Maps <ExternalLink size={14} strokeWidth={2} aria-hidden="true" />
    </a>
  </div>

  <div class="location-benefits" aria-label="Location information">
    <div><span><CarFront size={22} strokeWidth={2} /></span><strong>Easy Access</strong><small>By car, taxi or transfer</small></div>
    <div><span><Map size={22} strokeWidth={2} /></span><strong>Prime Location</strong><small>In the Palmeraie</small></div>
    <div><span><Star size={22} strokeWidth={2} /></span><strong>Near Marrakech</strong><small>Close to the city</small></div>
  </div>

  <p class="coordinates"><MapPin size={14} aria-hidden="true" /> {googleBusiness.latitude}, {googleBusiness.longitude}</p>
</article>

<style>
  .contact-map-card {
    min-width: 0;
    padding: 24px;
    border: 1px solid #e8e8e8;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 12px 32px rgba(8, 43, 79, .09);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 7px;
    color: #ff641f;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .section-label span {
    width: 30px;
    height: 2px;
    background: currentColor;
  }

  h2 {
    margin: 0;
    color: #082b4f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(27px, 2vw, 34px);
    line-height: 1.05;
  }

  .map-description {
    margin: 8px 0 16px;
    color: #6b7280;
    font-size: 13px;
    line-height: 1.45;
  }

  .map-frame {
    position: relative;
    height: 365px;
    overflow: hidden;
    border-radius: 11px;
    background: #eef0ec;
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map-frame > a {
    position: absolute;
    left: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    border-radius: 7px;
    background: #fff;
    color: #082b4f;
    box-shadow: 0 5px 18px rgba(8, 43, 79, .18);
    font-size: 12px;
    font-weight: 800;
  }

  .map-frame > a:hover,
  .map-frame > a:focus-visible {
    color: #ff641f;
  }

  .location-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .location-benefits > div {
    min-width: 0;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .location-benefits span {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    margin-bottom: 7px;
    border-radius: 50%;
    background: #fff0e8;
    color: #ff641f;
  }

  .location-benefits strong {
    color: #082b4f;
    font-size: 13px;
  }

  .location-benefits small {
    margin-top: 2px;
    color: #7a8391;
    font-size: 11px;
  }

  .coordinates {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin: 12px 0 0;
    color: #8b929e;
    font-size: 10px;
  }

  @media (max-width: 560px) {
    .contact-map-card {
      padding: 18px;
    }

    .map-frame {
      height: 310px;
    }

    .location-benefits {
      gap: 8px;
    }

    .location-benefits span {
      width: 44px;
      height: 44px;
    }
  }
</style>
