---
import { ArrowRight, Mail, Phone } from '@lucide/astro';
import { siFacebook, siInstagram, siX, siYoutube } from 'simple-icons';
import { contact, site } from '../data/tours';

const socialIcons = [
  { name: 'Facebook', icon: siFacebook, href: 'https://www.facebook.com/share/1JqPmPaaei/' },
  { name: 'YouTube', icon: siYoutube, href: null },
  { name: 'X', icon: siX, href: null },
  {
    name: 'Instagram',
    icon: siInstagram,
    href: 'https://www.instagram.com/atlas_quad_palmeraie?utm_source=qr&igsh=MXV2ZnMwMGdrbXQ4aw==',
  },
];
---

<footer id="contact" class="site-footer">
  <div class="footer-main">
    <div class="footer-container footer-grid">
      <div class="brand-column" data-reveal="up">
        <a class="footer-logo" href="/" aria-label="Atlas Quad Palmeraie home">
          <img src={site.logo} alt="Atlas Quad Palmeraie logo" loading="lazy" decoding="async" />
        </a>
        <p>Experience the wild beauty of Marrakech with Atlas Quad. Ride through palm groves, deserts, valleys and trails on our guided quad and camel adventures.</p>
      </div>

      <nav class="footer-menu" aria-label="Footer navigation" data-reveal="up" style="--delay: 80ms">
        <h2>Menu</h2>
        <a class="active" href="/">Home</a>
        <a href="/tours/">Tours</a>
        <a href="/#services">Services</a>
        <a href="/contact/">Contact</a>
        <a href="/#about">About Us</a>
      </nav>

      <div class="newsletter-column" data-reveal="up" style="--delay: 160ms">
        <h2>Get Updates &amp; More</h2>
        <p>Subscribe to our free newsletter<br />and stay up to date</p>
        <form class="newsletter-form" aria-label="Newsletter signup">
          <label class="sr-only" for="footer-email">Your email</label>
          <input id="footer-email" name="email" type="email" placeholder="Your email" autocomplete="email" />
          <button type="button" aria-label="Submit email"><ArrowRight size={20} strokeWidth={2.2} /></button>
        </form>
      </div>

      <div class="social-column" data-reveal="up" style="--delay: 240ms">
        <h2>Follow us</h2>
        <div class="social-list">
          {socialIcons.map(({ name, icon, href }) => (
            href ? (
              <a
                class="social-button"
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit Atlas Quad Palmeraie on ${name}`}
                title={name}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path}></path></svg>
              </a>
            ) : (
              <span class="social-button" role="img" aria-label={name} title={name}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path}></path></svg>
              </span>
            )
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-container bottom-row">
      <p>&copy; 2024 Atlas Quad Palmeraie. All rights reserved.</p>
      <div class="contact-links">
        <a href={contact.phoneHref}><Phone size={16} fill="currentColor" strokeWidth={0} /><span>{contact.phone}</span></a>
        <a href={contact.emailHref}><Mail size={17} strokeWidth={2} /><span>{contact.email}</span></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background: #08284b;
    color: #d5deea;
    font-size: 13px;
  }

  .footer-main {
    background: radial-gradient(circle at 77% 28%, rgba(20, 68, 112, 0.34), transparent 35%), #08284b;
  }

  .footer-container {
    width: min(calc(100% - 2rem), 940px);
    margin-inline: auto;
  }

  .footer-grid {
    min-height: 149px;
    display: grid;
    grid-template-columns: minmax(330px, 1.65fr) minmax(120px, 0.62fr) minmax(200px, 1fr) minmax(145px, 0.72fr);
    gap: clamp(24px, 4vw, 60px);
    align-items: start;
    padding: 21px 0 15px;
  }

  .site-footer h2 {
    margin: 0 0 11px;
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .brand-column {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }

  .footer-logo {
    width: 121px;
    height: 118px;
    margin-left: -6px;
    display: block;
  }

  .footer-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-column p,
  .newsletter-column p {
    margin: 0;
    color: #d5deea;
    line-height: 1.45;
  }

  .brand-column p {
    max-width: 205px;
  }

  .footer-menu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transform: translateX(15px);
  }

  .footer-menu a {
    padding: 1px 0;
    color: #e2e8f0;
    line-height: 1.28;
    transition: color 180ms ease;
  }

  .footer-menu a.active,
  .footer-menu a:hover,
  .footer-menu a:focus-visible {
    color: #ff6b20;
  }

  .newsletter-column p {
    margin-bottom: 13px;
  }

  .newsletter-column {
    width: 197px;
    transform: translateX(18px);
  }

  .newsletter-form {
    width: 100%;
    height: 38px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px;
  }

  .newsletter-form input {
    min-width: 0;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-right: 0;
    border-radius: 6px 0 0 6px;
    outline: 0;
    background: rgba(4, 25, 50, 0.32);
    color: #fff;
    font-size: 12px;
  }

  .newsletter-form input::placeholder {
    color: #aebdce;
  }

  .newsletter-form input:focus-visible {
    border-color: #ff6b20;
    box-shadow: inset 0 0 0 1px #ff6b20;
  }

  .newsletter-form button {
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 0 6px 6px 0;
    background: #ff6b20;
    color: #fff;
    cursor: pointer;
    transition: background 180ms ease;
  }

  .newsletter-form button:hover,
  .newsletter-form button:focus-visible {
    background: #e9550d;
  }

  .social-list {
    display: flex;
    gap: 10px;
  }

  .social-column {
    transform: translateX(4px);
  }

  .social-button {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 50%;
    color: #fff;
    transition: border-color 200ms ease, background 200ms ease, transform 200ms var(--motion-ease);
  }

  .social-button svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  .social-button:hover {
    border-color: #ff6b20;
    background: #ff6b20;
    transform: scale(1.08);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .bottom-row {
    min-height: 41px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .bottom-row p {
    margin: 0;
    color: #dce5f0;
    font-size: 12px;
  }

  .contact-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #ecf2f8;
    font-size: 12px;
    transition: color 180ms ease;
  }

  .contact-links a:hover,
  .contact-links a:focus-visible {
    color: #ff6b20;
  }

  @media (max-width: 900px) {
    .footer-container { width: min(calc(100% - 2.5rem), 720px); }
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 50px; padding-block: 34px; }
    .brand-column { grid-template-columns: 100px minmax(0, 1fr); }
    .brand-column p { max-width: 240px; }
    .footer-menu, .newsletter-column, .social-column { width: auto; transform: none; }
  }

  @media (max-width: 580px) {
    .footer-container { width: min(calc(100% - 2rem), 34rem); }
    .footer-grid { grid-template-columns: 1fr; gap: 27px; }
    .brand-column { grid-template-columns: 96px minmax(0, 1fr); gap: 17px; }
    .footer-logo { width: 96px; height: 91px; margin-left: 0; }
    .brand-column p { max-width: none; }
    .newsletter-form { max-width: 100%; height: 44px; grid-template-columns: minmax(0, 1fr) 46px; }
    .social-button { width: 36px; height: 36px; }
    .bottom-row { flex-direction: column; align-items: flex-start; gap: 12px; padding: 16px 0; }
    .contact-links { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>
